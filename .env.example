# DATABASE_URL
# Use o formato completo da conexão.
# Exemplos:
#   PostgreSQL: postgresql://usuario:senha@host:5432/meubanco
#   MySQL:      mysql+pymysql://usuario:senha@host:3306/meubanco
#   SQLite:     sqlite:///./app.db  (apenas para dev local)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/meubanco
